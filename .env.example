# App
APP_NAME=Scoring API
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# CORS
# Comma-separated origins, e.g. http://localhost:3000,http://localhost:5173
CORS_ORIGINS=

# Pinata / IPFS
PINATA_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs
# Leave empty in local/test to use the deterministic mock IPFS service.
PINATA_JWT=
IPFS_TIMEOUT_SECONDS=10.0
IPFS_MAX_BYTES=1000000
MAX_CONCURRENT_DOWNLOADS=10

# Satellite provider
SATELLITE_TIMEOUT_SECONDS=10.0
SATELLITE_PROVIDER=mock
SATELLITE_PROVIDER_BASE_URL=
SATELLITE_PROVIDER_OBSERVATION_PATH=/observations
SATELLITE_PROVIDER_API_KEY=

# Groq AI / LLM provider
# Create a free-tier key in GroqCloud and set it here.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_PATH=/chat/completions
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=20.0

# Scoring thresholds
APPROVE_THRESHOLD=70
REVIEW_THRESHOLD=45
DRASTIC_IMPROVEMENT_THRESHOLD=25
